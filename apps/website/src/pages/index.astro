        </div>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-[1240px] px-6 pb-24">
        <div
          class="flex flex-wrap items-center justify-between gap-8 rounded-[32px] bg-night px-8 py-12 text-cream sm:px-12 sm:py-14 dark:bg-gray-800"
        >
          <div class="flex flex-wrap items-center gap-7">
            <span
              class="flex size-[104px] items-center justify-center rounded-[26px] bg-cream"
            >
              <svg viewBox="0 0 140 120" class="w-20" role="img" aria-label="olio"
                ><use href="#olio-mark"></use></svg
              >
            </span>
            <div class="flex flex-col gap-2">
              <h2
                class="text-[clamp(28px,3.4vw,42px)] leading-[1.1] font-bold tracking-[-0.03em]"
