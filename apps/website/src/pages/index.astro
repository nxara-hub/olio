      >
        <div class="flex flex-wrap gap-x-16 gap-y-10">
          <div class="flex flex-[1_1_240px] flex-col gap-3.5">
            <div class="flex items-center gap-2.5">
              <Mark class="w-10 dark:w-9" />
              <span class="text-[22px] font-bold tracking-[-0.035em]">olio</span>
            </div>
            <p
              class="max-w-[260px] text-sm leading-relaxed text-gray-500 dark:text-gray-400"
            >
              Many modules. One schema. Open source by nxara.
            </p>
          </div>
          {
            [
              {
                label: "Docs",
                links: [
                  ["Introduction", docs],
                  ["Quick start", quickStart],
                  ["How the pieces fit", "/concepts/how-it-fits/"],
                  ["Project structure", "/concepts/project-structure/"]
                ]
              },
              {
                label: "Packages",
                links: packages
                  .slice(0, 5)
                  .map((pkg) => [
                    pkg.name === "olio" ? "olio" : `olio-${pkg.name}`,
                    `/reference/${pkg.name}/`
                  ])
              },
              {
                label: "Community",
                links: [
                  ["GitHub", repoUrl],
                  ["Issues", `${repoUrl}/issues`],
                  ["Releases", `${repoUrl}/releases`],
                  ["npm", "https://www.npmjs.com/package/@nxara/olio"]
                ]
              }
            ].map((group) => (
              <nav
                aria-label={group.label}
                class="flex flex-[0_1_170px] flex-col gap-1 text-sm"
              >
                <span class="pb-1.5 font-semibold">{group.label}</span>
                {group.links.map(([label, href]) => (
                  <a
                    href={href}
                    class="py-1.5 text-gray-600 hover:text-ink dark:text-gray-300 dark:hover:text-cream"
                  >
                    {label}
                  </a>
                ))}
              </nav>
            ))
          }
        </div>
        <div
          class="flex flex-wrap justify-between gap-3 border-t border-[#E8E1D8] pt-6 text-[13px] text-gray-500 dark:border-gray-800 dark:text-gray-400"
        >
          <span>© {new Date().getFullYear()} nxara · MIT License</span>
          <a href="https://www.npmjs.com/package/@nxara/olio">@nxara/olio on npm</a>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]"
      );
      const label = (): void => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        toggle?.setAttribute("aria-label", `Switch to ${next} theme`);
      };
      label();
      toggle?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {
          // Private windows can refuse storage; the theme still switches.
        }
        label();
      });

      const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
      copy?.addEventListener("click", async () => {
        const text = document.querySelector("[data-install]")?.textContent;
        if (text) {
          await navigator.clipboard.writeText(text.trim());
          copy.setAttribute("aria-label", "Copied");
        }
      });
    </script>
  </body>
