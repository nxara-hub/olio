---
import Mark from "./Mark.astro";
---

<div
  data-hero3d
  class="relative mx-auto aspect-square w-full max-w-[600px] sm:aspect-[7/6]"
>
  <div data-stage class="absolute inset-0"></div>
  <div
    data-fallback
    class="absolute inset-0 grid place-items-center dark:rounded-[36px] dark:bg-cream"
  >
    <Mark class="w-3/5" label="olio" bare />
  </div>
</div>

<script>
  type Theme = "light" | "dark";

  const root = document.querySelector<HTMLElement>("[data-hero3d]");
  const currentTheme = (): Theme =>
    document.documentElement.dataset.theme === "light" ? "light" : "dark";

  const start = async (el: HTMLElement): Promise<void> => {
    const stage = el.querySelector<HTMLElement>("[data-stage]");
    if (!stage) {
      return;
    }
    const { mount } = await import("./hero/olio-hero.js");
    const hero = mount(stage, { theme: currentTheme() });
    el.querySelector("[data-fallback]")?.remove();
    new MutationObserver(() => hero.setTheme(currentTheme())).observe(
      document.documentElement,
      { attributeFilter: ["data-theme"] }
    );
  };

  // The scene and three.js load only once the hero is on screen; until then,
  // and if WebGL fails, the static mark stays.
  if (root) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        start(root).catch(() => undefined);
      }
    });
    observer.observe(root);
  }
</script>
