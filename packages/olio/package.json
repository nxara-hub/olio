{
  "name": "@nxlab/olio",
  "version": "0.0.0",
  "description": "Modular, type-safe GraphQL applications.",
  "keywords": [
    "graphql",
    "modules",
    "nxara"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "bun test/typed/generate.ts && tsc -p tsconfig.test.json && tsc -p tsconfig.typed.json"
  },
  "dependencies": {
    "@nxlab/schema": "workspace:*"
  },
  "devDependencies": {
    "@nxlab/codegen": "workspace:*",
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.13.0"
  }
}
