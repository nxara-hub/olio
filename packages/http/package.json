{
  "name": "@nxara/olio-http",
  "version": "0.1.0-rc.1",
  "description": "Serve an olio app over HTTP, on any framework: GraphQL over HTTP with context, error masking and per-operation cleanup.",
  "keywords": [
    "graphql",
    "graphql-http",
    "http",
    "nxara"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxara-hub/olio.git",
    "directory": "packages/http"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@nxara/olio-core": "workspace:*",
    "graphql-http": "^1.23.1"
  },
  "devDependencies": {
    "@nxara/olio": "workspace:*",
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.13.0"
  }
}
