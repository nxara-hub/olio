{
  "name": "@nxara/olio-tools",
  "version": "0.1.0",
  "description": "Load olio modules, type definitions and resolvers from files.",
  "keywords": [
    "graphql",
    "nxara"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxara-hub/olio.git",
    "directory": "packages/tools"
  },
  "files": [
