  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@nxlab/olio": "workspace:*",
    "graphql": "^17.0.2"
  },
  "peerDependencies": {
    "@nxlab/olio": "workspace:*",
    "graphql": "^17.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
