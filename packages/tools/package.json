{
  "name": "@nxlab/tools",
  "version": "0.0.0",
  "description": "Load olio modules, type definitions and resolvers from files.",
  "keywords": [
    "graphql",
    "nxara"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
