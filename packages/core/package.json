{
  "name": "@nxara/olio-core",
  "version": "0.1.1",
  "description": "Contracts shared by the Nxara packages. Apps import from @nxara/olio and @nxara/olio-tools instead.",
  "keywords": [
    "graphql",
    "nxara"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxara-hub/olio.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
