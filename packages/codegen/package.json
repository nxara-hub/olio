{
  "name": "@nxara/olio-codegen",
  "version": "0.0.0",
  "description": "Generate TypeScript types from GraphQL SDL.",
  "keywords": [
    "codegen",
    "graphql",
    "nxara",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@nxara/olio-core": "workspace:*",
    "@nxara/olio-schema": "workspace:*"
  },
  "devDependencies": {
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
