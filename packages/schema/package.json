{
  "name": "@nxara/olio-schema",
  "version": "0.1.1",
  "description": "Compose module SDL into one validated GraphQL schema, with schema-design directives.",
  "keywords": [
    "compose",
    "directives",
    "graphql",
    "nxara",
    "schema",
    "sdl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxara-hub/olio.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "graphql": "^16.14.2"
  },
  "peerDependencies": {
    "graphql": "^16.13.0"
  }
}
