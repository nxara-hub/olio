{
  "name": "@nxlab/schema",
  "version": "0.0.0",
  "description": "Compose module SDL into one validated GraphQL schema, with schema-design directives.",
  "keywords": [
    "compose",
    "directives",
    "graphql",
    "nxara",
    "schema",
    "sdl"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "graphql": "^17.0.2"
  },
  "peerDependencies": {
    "graphql": "^17.0.0"
  }
}
